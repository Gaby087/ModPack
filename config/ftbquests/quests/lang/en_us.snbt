{
 "chapter_group.71C7157F1269A7DC.title": "A World to Keep",
 "file.0000000000000001.title": "Gaby - A World to Keep",
 "chapter.42E1A37F318050E4.title": "Getting Started",
 "chapter.42E1A37F318050E4.chapter_subtitle": [
  "Your first days: a partner, a roof and a little money."
 ],
 "quest.640FFCE345D97BEB.title": "A World to Keep",
 "quest.640FFCE345D97BEB.quest_desc": [
  "Welcome! Press G to open your Trainer Pad: Pokédex, team, gyms, orders, bounties, the catalog and your settlement.",
  "Quests are milestones, not chores. Do them in any order: the lines only suggest a path."
 ],
 "quest.196C011D653CC9B6.title": "Choose Your Partner",
 "quest.196C011D653CC9B6.quest_desc": [
  "Pick your starter Pokémon (press M if the starter screen did not open)."
 ],
 "quest.54212C610882C19C.title": "First Catch",
 "quest.54212C610882C19C.quest_desc": [
  "Weaken a wild Pokémon, then throw a ball."
 ],
 "reward.2A871D86FE6320A4.title": "$300",
 "quest.5667819B446892EA.title": "A Team of Three",
 "quest.5667819B446892EA.quest_desc": [
  "Catch three Pokémon. Different types will help in the first gym."
 ],
 "quest.227C77B50C5A3AC0.title": "Growing Stronger",
 "quest.227C77B50C5A3AC0.quest_desc": [
  "Raise a Pokémon to level 10."
 ],
 "quest.7C5FB88622EF35A1.title": "Evolution!",
 "quest.7C5FB88622EF35A1.quest_desc": [
  "Evolve any Pokémon."
 ],
 "reward.443CF78F545EF0C1.title": "$500",
 "quest.6C07AB591C7EDD50.title": "Ball Maker",
 "quest.6C07AB591C7EDD50.quest_desc": [
  "Apricorns grow on apricorn trees. Gather red and white ones: with iron they make Poké Balls."
 ],
 "quest.28C74AAC7E7C75B7.title": "Healing at Home",
 "quest.28C74AAC7E7C75B7.quest_desc": [
  "Build a Healing Machine so your team is always ready."
 ],
 "reward.4E60DC6706A4103E.title": "$400",
 "quest.298B23A3A38226A8.title": "Pokémon Storage",
 "quest.298B23A3A38226A8.quest_desc": [
  "Build a PC to store the Pokémon you are not carrying."
 ],
 "quest.69815060263A34FD.title": "A Roof Over Your Head",
 "quest.69815060263A34FD.quest_desc": [
  "Build a real house: a bed, a door, a chest and light. Tick this when you are happy with it."
 ],
 "reward.7A07380E1FE26488.title": "$500",
 "quest.30B9C80E18AAF3FB.title": "First Earnings",
 "quest.30B9C80E18AAF3FB.quest_desc": [
  "Sell goods to a town merchant (sneak + use with the stack in hand) or ship them with an Export Depot."
 ],
 "reward.67F0B7E49D1CB793.title": "$250",
 "quest.12F3C106CE3F7F00.title": "A Town Needs You",
 "quest.12F3C106CE3F7F00.quest_desc": [
  "Complete a production order from the Orders app."
 ],
 "quest.4F0E3163E4436A34.title": "Bounty Hunter",
 "quest.4F0E3163E4436A34.quest_desc": [
  "Complete a Pokémon bounty from the Bounties app."
 ],
 "quest.37CFF1FEBD4E760B.title": "The First Gym",
 "quest.37CFF1FEBD4E760B.quest_desc": [
  "Travel to Pewter City from the Gyms app and earn the Boulder Badge."
 ],
 "reward.66C56A76AF9ACB2F.title": "$1,000",
 "quest.644BB024B77E3B28.title": "Plant Your Banner",
 "quest.644BB024B77E3B28.quest_desc": [
  "Craft a Settlement Banner and plant it at your home: no monsters will spawn inside its perimeter."
 ],
 "reward.66CEA191BCB1D02C.title": "$800",
