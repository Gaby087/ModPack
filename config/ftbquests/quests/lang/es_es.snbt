 "chapter.319691D73BE3217D.title": "Leyendas",
 "chapter.319691D73BE3217D.chapter_subtitle": [
  "Gana una liga y te llegarán rumores de sus Pokémon legendarios. Cada cebo solo funciona donde vive su leyenda."
 ],
 "quest.7A7B646BE0EBD122.title": "Rumor: Articuno",
 "quest.7A7B646BE0EBD122.quest_desc": [
  "Seas o no Campeón de Kanto, pocos han visto a Articuno. Toma este Cebo Legendario.",
  "Dicen que vuela sobre los campos nevados.",
  "Usa el cebo allí (clic derecho) para llamarlo, luego combate y captúralo. Lleva Poké Balls buenas."
 ],
 "quest.3FC25F8D50BB6DF1.title": "Articuno",
