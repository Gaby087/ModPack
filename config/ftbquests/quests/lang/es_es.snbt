{
 "chapter_group.71C7157F1269A7DC.title": "A World to Keep",
 "file.0000000000000001.title": "Gaby - A World to Keep",
 "chapter.42E1A37F318050E4.title": "Primeros pasos",
 "chapter.42E1A37F318050E4.chapter_subtitle": [
  "Tus primeros días: un compañero, un techo y algo de dinero."
 ],
 "quest.640FFCE345D97BEB.title": "A World to Keep",
 "quest.640FFCE345D97BEB.quest_desc": [
  "¡Bienvenido! Pulsa G para abrir tu Tablet de Entrenador: Pokédex, equipo, gimnasios, pedidos, recompensas, el catálogo y tu asentamiento.",
  "Las misiones son metas, no tareas. Hazlas en el orden que quieras: las líneas solo sugieren un camino."
 ],
 "quest.196C011D653CC9B6.title": "Elige a tu compañero",
 "quest.196C011D653CC9B6.quest_desc": [
  "Elige tu Pokémon inicial (pulsa M si no se abrió la pantalla de iniciales)."
 ],
 "quest.54212C610882C19C.title": "Primera captura",
 "quest.54212C610882C19C.quest_desc": [
  "Debilita a un Pokémon salvaje y luego lanza una Ball."
 ],
 "reward.2A871D86FE6320A4.title": "$300",
 "quest.5667819B446892EA.title": "Un equipo de tres",
 "quest.5667819B446892EA.quest_desc": [
  "Captura tres Pokémon. Tener tipos distintos te ayudará en el primer gimnasio."
 ],
 "quest.227C77B50C5A3AC0.title": "Cada vez más fuerte",
 "quest.227C77B50C5A3AC0.quest_desc": [
  "Sube un Pokémon al nivel 10."
 ],
 "quest.7C5FB88622EF35A1.title": "¡Evolución!",
 "quest.7C5FB88622EF35A1.quest_desc": [
  "Haz evolucionar a cualquier Pokémon."
 ],
 "reward.443CF78F545EF0C1.title": "$500",
 "quest.6C07AB591C7EDD50.title": "Fabricante de Balls",
 "quest.6C07AB591C7EDD50.quest_desc": [
  "Los Bonguris crecen en árboles de Bonguri. Recoge rojos y blancos: con hierro se hacen Poké Balls."
 ],
 "quest.28C74AAC7E7C75B7.title": "Curación en casa",
 "quest.28C74AAC7E7C75B7.quest_desc": [
  "Construye una Máquina de Curación para tener siempre listo a tu equipo."
 ],
 "reward.4E60DC6706A4103E.title": "$400",
 "quest.298B23A3A38226A8.title": "Almacén Pokémon",
 "quest.298B23A3A38226A8.quest_desc": [
  "Construye un PC para guardar los Pokémon que no llevas encima."
 ],
 "quest.69815060263A34FD.title": "Un techo bajo el que dormir",
 "quest.69815060263A34FD.quest_desc": [
  "Construye una casa de verdad: cama, puerta, cofre y luz. Márcala cuando estés contento con ella."
 ],
 "reward.7A07380E1FE26488.title": "$500",
 "quest.30B9C80E18AAF3FB.title": "Primeras ganancias",
 "quest.30B9C80E18AAF3FB.quest_desc": [
  "Vende mercancía a un mercader del pueblo (agáchate + usar con el montón en la mano) o envíala con un Depósito de Exportación."
 ],
 "reward.67F0B7E49D1CB793.title": "$250",
 "quest.12F3C106CE3F7F00.title": "Un pueblo te necesita",
 "quest.12F3C106CE3F7F00.quest_desc": [
  "Completa un pedido de producción de la app Pedidos."
 ],
 "quest.4F0E3163E4436A34.title": "Cazarrecompensas",
 "quest.4F0E3163E4436A34.quest_desc": [
